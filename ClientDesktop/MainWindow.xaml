<Window x:Class="ClientDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientDesktop"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="IPInput" HorizontalAlignment="Center" Margin="0,87,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBlock x:Name="IPTextBlock" HorizontalAlignment="Center" Margin="0,55,0,0" TextWrapping="Wrap" Text="IP Address" VerticalAlignment="Top"/>
        <TextBlock x:Name="PortTextBlock" HorizontalAlignment="Center" Margin="0,110,0,0" TextWrapping="Wrap" Text="Port" VerticalAlignment="Top"/>
        <TextBox x:Name="PortInput" HorizontalAlignment="Center" Margin="0,142,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="RegisterClientButton" Content="Register Client IP + Port" HorizontalAlignment="Center" Margin="0,174,0,0" VerticalAlignment="Top" Click="RegisterButton_OnClick"/>
        <TextBlock x:Name="PythonTextBlock" HorizontalAlignment="Left" Margin="91,201,0,0" TextWrapping="Wrap" Text="Python Code" VerticalAlignment="Top" Height="24" Width="84"/>
        <TextBox x:Name="PythonInput" HorizontalAlignment="Center" Margin="0,230,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="618" Height="145"/>
        <Button x:Name="PythonJobSubmitButton" Content="Submit Job" HorizontalAlignment="Center" Margin="0,389,0,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="ClientWorkingTextBlock" HorizontalAlignment="Left" Margin="638,55,0,0" TextWrapping="Wrap" Text="Working?" VerticalAlignment="Top"/>
        <TextBlock x:Name="JobCountTextBlock" HorizontalAlignment="Left" Margin="630,110,0,0" TextWrapping="Wrap" Text="Jobs Finished:" VerticalAlignment="Top"/>
        <Button x:Name="RefreshUIButton" Content="Refresh" HorizontalAlignment="Left" Margin="641,174,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
